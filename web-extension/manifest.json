{
  "manifest_version": 3,
  "name": "copyNpaste — Clipboard-Magazin",
  "version": "1.1.0",
  "description": "Magazin für die Zwischenablage im Browser: Kopien stapeln, durchsuchen und mit einem Klick zurückkopieren. Begleit-Add-on zur gleichnamigen Desktop-App.",
  "author": "johan",
  "homepage_url": "https://github.com/Johi251/copyNpaste",
  "minimum_chrome_version": "100",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "copyNpaste — Magazin öffnen",
    "default_popup": "popup.html"
  },
  "permissions": ["storage", "clipboardRead", "clipboardWrite"],
  "commands": {
    "push-clipboard": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "Aktuelle Zwischenablage ins Magazin schieben"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "copynpaste@johan.tools",
      "strict_min_version": "109.0"
    }
  }
}
